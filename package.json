{
  "name": "@p5-wrapper/react",
  "description": "A wrapper component that allows you to utilise P5 sketches within React apps.",
  "version": "5.0.5",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.20.0"
  },
  "homepage": "https://github.com/P5-wrapper/react",
  "license": "MIT",
  "files": [
    "README.md",
    "dist/component/*"
  ],
  "types": "./dist/component/main.d.ts",
  "main": "./dist/component/main.cjs",
  "module": "./dist/component/main.mjs",
  "exports": {
    ".": {
      "types": "./dist/component/main.d.ts",
      "import": "./dist/component/main.mjs",
      "require": "./dist/component/main.cjs"
    }
  },
  "scripts": {
    "build": "rimraf dist && pnpm build:component && pnpm build:demo",
    "build:component": "tsc && vite build --config config/vite/vite.config.ts --mode lib",
    "build:demo": "vite build --config config/vite/vite.config.ts --mode demo",
    "dev": "vite --config config/vite/vite.config.ts --host",
    "format": "biome check --write .",
    "integrate": "pnpm lint && pnpm test && pnpm build",
    "lint": "biome check .",
    "test": "vitest run --config config/vite/vite.config.ts",
    "test:coverage": "vitest run --coverage --config config/vite/vite.config.ts",
    "test:watch": "vitest watch --config config/vite/vite.config.ts"
  },
  "keywords": [
    "react",
    "react-component",
    "p5",
    "processing",
    "typescript"
  ],
  "author": {
    "name": "James Robb",
    "url": "https://github.com/jamesrweb"
  },
  "contributors": [
    {
      "name": "Eugene Dyko",
      "url": "https://github.com/yevdyko"
    },
    {
      "name": "Andreas Wolf",
      "email": "info@wolfandreas.com",
      "url": "https://github.com/and-who"
    },
    {
      "name": "Ivan Malyugin"
    },
    {
      "name": "Benjamin Saphier",
      "url": "https://github.com/bsaphier"
    },
    {
      "name": "Mark Fuller",
      "url": "https://github.com/MarkFuller1"
    },
    {
      "name": "Nathan Manousos",
      "url": "https://github.com/trafnar"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P5-wrapper/react.git"
  },
  "bugs": {
    "url": "https://github.com/P5-wrapper/react/issues"
  },
  "dependencies": {
    "@p5-wrapper/common": "^0.1.1",
    "react-error-boundary": "^6.1.6"
  },
  "peerDependencies": {
    "p5": ">= 2.0.0",
    "react": ">= 19.0.0",
    "react-dom": ">= 19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@biomejs/biome": "2.6.6",
    "@microsoft/api-extractor": "^7.60.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "gh-pages": "^6.3.0",
    "happy-dom": "^21.0.4",
    "p5": "2.3.4",
    "p5.capture": "^1.6.1",
    "p5.record.js": "^0.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "^6.1.4",
    "typescript": "6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vitest-canvas-mock": "^1.2.0"
  }
}
